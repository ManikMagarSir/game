# ============================================================
# Voxel Survivor R3F — SINGLE POINT of control for cross-origin
# behavior. Every CORS value below is read by vite.config.ts
# (dev server + preview + proxy). Nothing else in the repo sets
# CORS headers, and the app itself makes zero cross-origin
# requests (Three.js is bundled, no CDN, no backend yet).
# Personal overrides go in `.env.local` (git-ignored).
# ============================================================

# Origin allowed to read dev/preview responses (use * only for local dev)
CORS_ALLOW_ORIGIN=http://127.0.0.1:5173

# Preflight surface
CORS_ALLOW_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOW_HEADERS=Content-Type,Authorization

# Optional dev-only proxy for a future backend: requests to /api are
# forwarded here (same-origin for the browser, so no CORS involved).
# Leave empty to disable.
API_PROXY_TARGET=
